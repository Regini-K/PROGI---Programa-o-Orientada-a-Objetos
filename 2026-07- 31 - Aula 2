package com.mycompany.aula02_poo_31_07;

/**
 *
 * @author alunolab11
 */
public class Pessoa {

    String nome, CPF, telefone;//variavel global
    int idade;
    double altura, peso; //essas são variaveis da classe

    Pessoa() {
    }

    Pessoa(String CPF, String nome, int idade, //variavel local, essas são variaveis do metodo
            double altura, double peso, String telefone) {
        this.CPF = CPF;
        this.nome = nome;
        this.idade = idade;
        this.altura = altura;
        this.peso = peso;
        this.telefone = telefone;
    }
}

