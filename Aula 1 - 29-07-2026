package com.mycompany.aula01_poo_29_07_2026;

/**
 *
 * @author alunolab11
 */
public class Pessoa {
    String nome, CPF, telefone;//variavel global
    int idade;
    double altura, peso; //essas são variaveis da classe
    
    Pessoa(String CPF, String nome, int idade, //variavel local
            double altura, double peso, String telefone){ //essas são variaveis do metodo}
        this.CPF = CPF;
        this.nome = nome;
        this.idade = idade;
        this.altura = altura;
        this.peso = peso;
        this.telefone = telefone;
    }      
}
