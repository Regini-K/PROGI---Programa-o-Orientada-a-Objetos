package com.mycompany.aula06_14_08_2026;

/**
 *
 * @author alunolab11
 */
public class Conta {

    private int agencia, numero;
    private double saldo; //só pode ser usado dentro dessa classe, nao da pra modificar o saldo fora

    Conta() {
    }

    Conta(int agencia, int numero) {
        this.agencia = agencia;
        this.numero = numero;
    }//para conta que pode ser criada sem saldo

    Conta(int agencia, int numero, double saldo) {
        this.agencia = agencia;
        this.numero = numero;
        this.saldo = saldo;
    }//conta tem que ter saldo para ser criada

    double getSaldo() {
        return saldo;
    } // nao tem etodo set para saldo por conta de segurança

    int getAgencia() {
        return agencia;
    }

    int getNumero() {
        return numero;
    }

    void setAgencia(int agencia) {
        this.agencia = agencia;
    } //set tem tipo void e tem que ter parametros nesse caso agencia

    void setNumero(int numero) {
        this.numero = numero;
    }

    //criar metodos creditar(por na conta), debitar(tirar da conta) e transferir(tirar de uma par aa outra)
    void creditar(double valor) {
        if (valor > 0) {
            this.saldo += valor;
            System.out.println("Valor Creditado!");
        } else {
            System.out.println("ERROR: Valor invalido!!");
        }
    }

    boolean debitar(double valor) {
        if (valor > 0) {
            if (this.saldo >= valor) {
                this.saldo -= saldo;
                System.out.println("Debido Realizado");
                return true;
            } else {
                System.out.println("ERROR: Saldo Insuficiemte!");
                return false;
            }
        } else {
            System.out.println("ERROR: Valor invalido!!");
        }
        return false;
    }

    void transferir(double valor, Conta destino) {//"Conta" é o tipo da variavel, maiusculopq é uma classe.
        if (debitar(valor)) {
            destino.creditar(valor);
        } else {
            System.out.println("Transferencia Negada!");
        }
    }

    @Override
    public String toString() {
        return "Conta \n Agencia: " + getAgencia() +"\n Numero: "+ getNumero() + "\n Saldo: " + getSaldo();
    } //metodo padrao do java para puxar todos os dados de um objeto.

}

//existe a herança no POO, nela temos uma classe filha que recebe todos os atributos PUBLICOS de uma classe pai.
//se for privado esse atributo não é passado em herança
// para fazermos isso usamos o "extend"


